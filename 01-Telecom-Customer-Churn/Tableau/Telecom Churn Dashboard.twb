              <calculation class='tableau' formula='IF [MonthlyCharges] &lt; 30 THEN &quot;Below $30&quot;&#13;&#10;&#13;&#10;ELSEIF [MonthlyCharges] &lt;= 60 THEN &quot;$30 - $60&quot;&#13;&#10;&#13;&#10;ELSEIF [MonthlyCharges] &lt;= 90 THEN &quot;$60 - $90&quot;&#13;&#10;&#13;&#10;ELSE &quot;Above $90&quot;&#13;&#10;&#13;&#10;END' />
