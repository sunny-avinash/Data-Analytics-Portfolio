      <aliases enabled='yes' />
      <column caption='Tenure Group' datatype='string' name='[Calculation_0269411187523584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0-12 Months&quot;&#13;&#10;&#13;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;13-24 Months&quot;&#13;&#10;&#13;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;25-48 Months&quot;&#13;&#10;&#13;&#10;ELSE &quot;49+ Months&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_0269411189727233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SeniorCitizen] = 1 THEN &quot;Senior Citizen&quot;&#13;&#10;ELSE &quot;Non Senior Citizen&quot;&#13;&#10;END' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_0752096597622784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Churn] = &quot;Yes&quot;&#13;&#10;THEN [customerID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_0752096598224897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Churn] = &quot;No&quot;&#13;&#10;THEN [customerID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_0752096598630402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [Churn]=&quot;Yes&quot;&#13;&#10;THEN [customerID]&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNT([customerID])' />
      </column>
      <column caption='Monthly Charge Group' datatype='string' name='[Calculation_0752096619081731]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MonthlyCharges] &lt; 30 THEN &quot;Below $30&quot;&#13;&#10;&#13;&#10;ELSEIF [MonthlyCharges] &lt;= 60 THEN &quot;$30 - $60&quot;&#13;&#10;&#13;&#10;ELSEIF [MonthlyCharges] &lt;= 90 THEN &quot;$60 - $90&quot;&#13;&#10;&#13;&#10;ELSE &quot;Above $90&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Churn]' role='dimension' type='nominal' />
      <column caption='Device Protection' datatype='string' name='[DeviceProtection]' role='dimension' type='nominal' />
      <column caption='Internet Service' datatype='string' name='[InternetService]' role='dimension' type='nominal' />
